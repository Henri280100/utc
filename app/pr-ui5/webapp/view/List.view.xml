<mvc:View
  controllerName="sap.ui.prui5.controller.List"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
>
  <f:DynamicPage
    id="idDynamicPage"
    toggleHeaderOnTitleClick="false"
  >
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="Purchase Requisitions" />
        </f:heading>
      </f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader>
        <OverflowToolbar height="6rem" class="sapUiSmallMarginTopBottom">
          <!-- Basic Search spans full row on phones -->
          <VBox
            width="16rem"
            class="sapUiSmallMarginEnd"
          >
            <Label
              text="Search"
              labelFor="idBasicSearch"
            />
            <SearchField search=".onSearchFieldBasicSearch" />
          </VBox>
          <VBox
            width="16rem"
            class="sapUiSmallMarginEnd"
          >
            <Label
              text="Purchasing Group"
              labelFor="idPurchasingGroupIDMultiInput"
            />
            <MultiInput
              id="idPurchasingGroupIDMultiInput"
              placeholder="Search by PG"
              showValueHelp="true"
              valueHelpRequest=".onMultiInputValueHelpRequest"
              tokenUpdate=".onMultiInputTokenUpdate"
            >
              <core:Item
                key="{PurchaseRequisition>PurchasingGroup/purchasingGroup}"
                text="{PurchaseRequisition>PurchasingGroup/purchasingGroup}"
              />
            </MultiInput>
          </VBox>
          <VBox
            width="16rem"
            class="sapUiSmallMarginEnd"
          >
            <Label
              text="Customer"
              labelFor="idCustomerNameMultiInput"
            />
            <MultiInput
              id="idCustomerNameMultiInput"
              placeholder="Search by Customer Name"
              showValueHelp="true"
              valueHelpRequest=".onMultiInputValueHelpRequest"
              tokenUpdate=".onMultiInputTokenUpdate"
            >
              <core:Item
                key="{salesOrder>CustomerName}"
                text="{salesOrder>CustomerName}"
              />
            </MultiInput>
          </VBox>
          <VBox
            width="16rem"
            class="sapUiSmallMarginEnd"
          >
            <Label
              text="Product"
              labelFor="idProductIDMultiInput"
            />
            <MultiInput
              id="idProductIDMultiInput"
              placeholder="Search by Product ID"
              showValueHelp="true"
              valueHelpRequest=".onMultiInputValueHelpRequest"
              tokenUpdate=".onMultiInputTokenUpdate"
            >
              <core:Item
                key="{salesOrder>ToLineItems/ProductID}"
                text="{salesOrder>ToLineItems/ProductID}"
              />
            </MultiInput>
          </VBox>
          <HBox
            width="16rem"
            fitContainer="true"
            alignItems="Center"
            alignContent="Start"
            class="sapUiSmallMarginTopBottom sapCenterGroupButtons"
          >
            <Button
              type="Emphasized"
              text="Go"
              id="idGoButton"
              press=".onGoButtonPress"

            />
            <Button
              text="Adapt Filter"
              type="Transparent"
              press=".onFilterOverflowToolbarButtonPress"
            />
          </HBox>
        </OverflowToolbar>
      </f:DynamicPageHeader>
    </f:header>
    <f:content>
      <VBox fitContainer="true">
        <OverflowToolbar class="sapFDynamicPageAlignContent">
          <ToolbarSpacer />
          <OverflowToolbarButton
            icon="sap-icon://add"
            text="Create"
            id="idAddOverflowToolbarButton"
            type="Emphasized"
            press=".onAddOverflowToolbarButtonPress"
          />
          <OverflowToolbarButton
            icon="sap-icon://sort"
            text="Sort"
            type="Transparent"
            press=".onSortOverflowToolbarButtonPress"
          />
          <ToolbarSeparator />
          <OverflowToolbarButton
            text="Settings"
            icon="sap-icon://action-settings"
            type="Transparent"
            press=".onSettingsOverflowToolbarButtonPress"
          />
          <MenuButton
            tooltip="Export"
            icon="sap-icon://excel-attachment"
            buttonMode="Split"
            useDefaultActionOnly="true"
            id="idExportMenuButton"
            type="Transparent"
          >
            <menu>
              <Menu itemSelected=".onMenuItemSelected">
                <MenuItem
                  text="Export as"
                  icon="sap-icon://attachment-zip-file"
                />
                <MenuItem
                  text="Export"
                  icon="sap-icon://excel-attachment"
                />
              </Menu>
            </menu>
          </MenuButton>
          <ToolbarSpacer width="1.5rem" />
        </OverflowToolbar>
        <Table
          growing="true"
          mode="MultiSelect"
          id="idPurchaseRequisitionTable"
          inset="false"
          items="{
            parameters: {
            $expand: 'material($select=material;$expand=materialDescriptions($select=materialDescriptions,language)),plant($select=plant)'
            },
            path: 'PurchaseRequisition>/PurchaseRequisition',
            sorter: {
              path: 'purchaseRequisition'
            }
          }"
          class="sapFDynamicPageAlignContent"
          width="auto"
        >
          <columns>
            <Column width="12em">
              <Text text="Requisition ID" />
            </Column>
            <Column>
              <Text text="Material" />
            </Column>
            <Column>
              <Text text="Material Description" />
            </Column>
            <Column>
              <Text text="Quantity" />
            </Column>
            <Column>
              <Text text="Delivery Date" />
            </Column>
            <Column>
              <Text text="Release Status" />
            </Column>
            <Column>
              <Text text="Requisition Date" />
            </Column>
            <Column>
              <Text text="Requisitioner" />
            </Column>
            <Column>
              <Text text="Plant" />
            </Column>
            <Column>
              <Text text="Purchase Requisition Type" />
            </Column>
          </columns>
          <items>
            <ColumnListItem
              type="Navigation"
              press=".onColumnListItemPress"
            >
              <cells>
                <ObjectIdentifier
                  title="{PurchaseRequisition>purchaseRequisition}"
                  text="Item: {PurchaseRequisition>purchaseReqnItem}"
                />
                <Text text="{PurchaseRequisition>material/material}" />
                <Text text="{
                        path: 'PurchaseRequisition>material/materialDescriptions',
                        targetType: 'any',
                        formatter: '.formatter.pickDescriptionByUILang'
                      }" />
                <ObjectNumber
                  number="{PurchaseRequisition>quantity}"
                  unit="{PurchaseRequisition>baseUnit}"
                />
                <ObjectAttribute
                
                text="{
                  path: 'PurchaseRequisition>deliveryDate',
                  type: 'sap.ui.model.odata.type.Date',
                  formatOptions: {
                    style: 'medium'
                  }
                }"
              />
                <ObjectAttribute
                
                text="{PurchaseRequisition>releaseStatus}"
              />
              <ObjectAttribute
                
                text="{
                  path: 'PurchaseRequisition>requisitionDate',
                  type: 'sap.ui.model.odata.type.Date',
                  formatOptions: {
                    style: 'medium'
                  }
                }"
              />
              <Text text="{PurchaseRequisition>requisitioner}"/>
              <Text text="{PurchaseRequisition>plant/plant}"/>
              <Text text="{PurchaseRequisition>PurchaseRequisitionType}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </f:content>
    <f:footer>
      <OverflowToolbar>
        <ToolbarSpacer />
        <Button
          type="Accept"
          text="Accept"
        />
        <Button
          type="Reject"
          text="Reject"
        />
      </OverflowToolbar>
    </f:footer>
  </f:DynamicPage>
</mvc:View>