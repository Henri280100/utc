<mvc:View
  controllerName="sap.ui.prui5.controller.List"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:mvc="sap.ui.core.mvc">

  <f:DynamicPage id="idDynamicPage" toggleHeaderOnTitleClick="false">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="Purchase Requisitions" />
        </f:heading>
      </f:DynamicPageTitle>
    </f:title>

    <f:content>
      <VBox fitContainer="true">
        <OverflowToolbar class="sapFDynamicPageAlignContent">
          <ToolbarSpacer />
          <SearchField search=".onSearchFieldBasicSearch" width="17.5rem" />
          <OverflowToolbarButton icon="sap-icon://add" text="Add" type="Transparent"
            press=".onAddOverflowToolbarButtonPress" />
          <OverflowToolbarButton icon="sap-icon://sort" text="Sort" type="Transparent"
            press=".onSortOverflowToolbarButtonPress" />
        </OverflowToolbar>

        <Table
          growing="true"
          mode="MultiSelect"
          id="idPurchaseRequisitionTable"
          inset="false"
          items="{
            parameters: {
              $select: 'purchaseRequisition,purchaseReqnItem,quantity,baseUnit,deliveryDate,releaseStatus'
            },
            path: 'PurchaseRequisition>/PurchaseRequisition',
            sorter: {
              path: 'purchaseRequisition'
            }
          }"
          class="sapFDynamicPageAlignContent"
          width="auto">

          <columns>
            <Column width="12em">
              <Text text="Requisition ID" />
            </Column>
            <Column>
              <Text text="Material" />
            </Column>
            <Column>
              <Text text="Quantity" />
            </Column>
            <Column>
              <Text text="Delivery Date" />
            </Column>
            <Column>
              <Text text="Status" />
            </Column>
          </columns>

          <items>
            <ColumnListItem type="Navigation" press=".onColumnListItemPress">
              <cells>
                <ObjectIdentifier title="{PurchaseRequisition>purchaseRequisition}"
                  text="{PurchaseRequisition>purchaseReqnItem}" />
                <Text
                  text="{PurchaseRequisition>material/materialDescriptions/0/materialDescriptions}" />
                <ObjectNumber number="{PurchaseRequisition>quantity}"
                  unit="{PurchaseRequisition>baseUnit}" />
                <Text text="{PurchaseRequisition>deliveryDate}" />
                <Text text="{PurchaseRequisition>releaseStatus}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </f:content>

    <f:footer>
      <OverflowToolbar>
        <ToolbarSpacer />
        <Button type="Accept" text="Accept" />
        <Button type="Reject" text="Reject" />
      </OverflowToolbar>
    </f:footer>
  </f:DynamicPage>
</mvc:View>