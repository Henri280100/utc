<c:FragmentDefinition
	xmlns="sap.ui.comp.valuehelpdialog"
	xmlns:c="sap.ui.core"
	xmlns:filterbar="sap.ui.comp.filterbar"
>
	<ValueHelpDialog
		id="idSmartFilterBar"
		title="Value Help"
		supportMultiselect="true"
		supportRanges="false"
		basicSearchText=""
		draggable="true"
	>
		<!-- fires when user types in VHD search -->
		<filterBar>
			<filterbar:FilterBar
				id="idFilterBar"
				advancedMode="true"
				isRunningInValueHelpDialog="true"
			>
				<filterbar:filterGroupItems>
				</filterbar:filterGroupItems>
			</filterbar:FilterBar>
		</filterBar>
	</ValueHelpDialog>
</c:FragmentDefinition>