{
  "_version": "1.38.0",
  "sap.app": {
    "id": "sap.ui.prui5",
    "type": "application",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "PurchaseRequisitionsService": {
        "uri": "/odata/v4/purchase-requisitions/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "sap.ui.prui5.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "models": {
      "PurchaseRequisition": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "dataSource": "PurchaseRequisitionsService",
        
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "groupId": "$direct",
          "updateGroupId": "$auto"
        }
      }
    },
    "dependencies": {
      "minUI5Version": "1.98.0",
      "libs": {
        "sap.f": {},
        "sap.m": {},
        "sap.uxap": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "config": {
      "fullWidth": true
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "path": "sap.ui.prui5.view",
        "controlId": "idFlexibleColumnLayout",
        "transition": "slide",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "list",
          "target": [
            "list",
            "detail"
          ]
        },
        {
          "pattern": "detail/{PurchasingInfoRecords}",
          "name": "detail",
          "target": [
            "detail"
          ]
        }
      ],
      "targets": {
        "list": {
          "name": "List",
          "viewLevel": 1
        },
        "detail": {
          "name": "Detail",
          "viewLevel": 2
        }
      }
    }
  }
}