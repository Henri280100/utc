{
  "_version": "1.38.0",
  "sap.app": {
    "id": "sap.ui.prui5",
    "type": "application",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "PurchaseRequisitionsService": {
        "uri": "/odata/v4/purchase-requisitions/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "sap.ui.prui5.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "models": {
      "PurchaseRequisition": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "dataSource": "PurchaseRequisitionsService",

        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "groupId": "$direct",
          "updateGroupId": "$auto"
        }
      }
    },
    "dependencies": {
      "minUI5Version": "1.139.0",
      "libs": {
        "sap.f": {},
        "sap.m": {},
        "sap.ui.comp": {},
        "sap.ui.fl": {},
        "sap.ui.mdc": {},
        "sap.uxap": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "config": {
      "fullWidth": true
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "path": "sap.ui.prui5.view",
        "controlId": "idFlexibleColumnLayout",
        "transition": "slide",
        "async": true
      },
      "routes": [
        {
          "pattern": ":layout:",
          "name": "List",
          "target": ["List", "detail"]
        },
        {
          "pattern": "detail/{ctxPath}/{layout}",
          "name": "detail",
          "target": ["List", "detail"]
        }
      ],
      "targets": {
        "List": {
          "viewName": "List",
          "viewLevel": 1,
          "viewId": "listView",
          "controlAggregation": "beginColumnPages"
        },
        "detail": {
          "viewName": "Detail",
          "viewLevel": 2,
          "viewId": "detailView",
          "controlAggregation": "midColumnPages"
        }
      }
    }
  }
}
