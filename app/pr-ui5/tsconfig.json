{
  "compilerOptions": {
    "moduleResolution": "node",
    "lib": ["es6"],
    "target": "es6",
    "module": "es6",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "baseUrl": "./",
    "paths": {
      "pr-ui5/*": ["webapp/*"]
    }
  },
  "include": ["webapp/**/*"]
}
