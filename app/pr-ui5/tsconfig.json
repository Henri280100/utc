{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "types": ["@sapui5/types"],
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "rootDir": "webapp",
    "baseUrl": "./",
    "noEmit": true,
    "paths": {
      "sap/ui/prui5/*": ["webapp/*"],

    }
  },
  "include": ["./webapp/**/*"]

}
